{
  "entities": {
    "CurriculumManifest": {
      "title": "CurriculumManifest",
      "description": "Shared live ISCEB curriculum release manifest and native APK version metadata for cross-device auto-sync",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "description": "Firebase UID of the verified administrator who published the manifest"
        },
        "versionCode": {
          "type": "integer",
          "description": "Monotonically increasing curriculum release version code"
        },
        "versionTag": {
          "type": "string",
          "description": "Human-readable curriculum release version tag (e.g. v1.1.0)"
        },
        "publishedTimestamp": {
          "type": "integer",
          "description": "Epoch milliseconds when published"
        },
        "publishedBy": {
          "type": "string",
          "description": "Publisher display name and designation"
        },
        "releaseNotes": {
          "type": "string",
          "description": "Summary of syllabus or feature changes"
        },
        "announcement": {
          "type": "string",
          "description": "Academic notice broadcast to all installed devices"
        },
        "minSupportedAppVersion": {
          "type": "integer",
          "description": "Minimum supported Android app versionCode"
        },
        "latestApkVersionCode": {
          "type": "integer",
          "description": "Latest published Android APK versionCode"
        },
        "latestApkVersionName": {
          "type": "string",
          "description": "Latest published Android APK versionName"
        },
        "apkDownloadUrl": {
          "type": "string",
          "description": "Official APK download or release URL (unchanged existing installation link)"
        },
        "apkReleaseNotes": {
          "type": "string",
          "description": "Release notes for native Android APK update"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) when document was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) when document was last updated"
        }
      },
      "required": [
        "authorUid",
        "versionCode",
        "versionTag",
        "publishedTimestamp",
        "publishedBy",
        "releaseNotes",
        "minSupportedAppVersion",
        "latestApkVersionCode",
        "latestApkVersionName",
        "apkDownloadUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurriculumCatalog": {
      "title": "CurriculumCatalog",
      "description": "Live ISCEB modules, lectures, media metadata, and completion settings snapshot",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "description": "Firebase UID of verified administrator"
        },
        "versionCode": {
          "type": "integer",
          "description": "Matching curriculum manifest versionCode"
        },
        "modules": {
          "type": "array",
          "description": "List of course module maps (max 50)"
        },
        "classes": {
          "type": "array",
          "description": "List of course class maps (max 200)"
        },
        "settings": {
          "type": "object",
          "description": "Institutional and completion governance rules map"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update"
        }
      },
      "required": [
        "authorUid",
        "versionCode",
        "modules",
        "classes",
        "settings",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Per-user per-class learning progress preserved across live updates",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "classId": {
          "type": "string",
          "description": "Course class identifier"
        },
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "LOCKED"],
          "description": "Current class completion status"
        },
        "activeLearningSeconds": {
          "type": "integer",
          "description": "Total active learning seconds recorded"
        },
        "maxPlaybackPercent": {
          "type": "number",
          "description": "Highest audio/video playback completion percent (0-100)"
        },
        "isPdfConfirmed": {
          "type": "boolean",
          "description": "Whether student confirmed reviewing class PDF"
        },
        "pdfReadingSeconds": {
          "type": "integer",
          "description": "Total PDF study seconds"
        },
        "quizScore": {
          "type": "integer",
          "description": "Optional latest quiz percentage score"
        },
        "quizPassed": {
          "type": "boolean",
          "description": "Whether class quiz threshold was passed"
        },
        "completionTimestamp": {
          "type": "integer",
          "description": "Optional epoch ms when class completed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update"
        }
      },
      "required": [
        "userId",
        "classId",
        "status",
        "activeLearningSeconds",
        "maxPlaybackPercent",
        "isPdfConfirmed",
        "pdfReadingSeconds",
        "quizPassed",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Authoritative server-managed admin grant records",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "LessonFileChunk": {
      "title": "LessonFileChunk",
      "description": "Chunked Base64 binary payload enabling cross-device Firestore distribution of admin-uploaded PDFs, slides, and images without Firebase Storage dependency",
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "description": "Logical file identifier matching LessonMedia.cloudFileId"
        },
        "chunkIndex": {
          "type": "integer",
          "description": "Zero-based chunk index"
        },
        "totalChunks": {
          "type": "integer",
          "description": "Total chunk count for reassembly"
        },
        "dataBase64": {
          "type": "string",
          "description": "Base64-encoded chunk bytes"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase UID of the verified administrator who uploaded the file"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update"
        }
      },
      "required": [
        "fileId",
        "chunkIndex",
        "totalChunks",
        "dataBase64",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/curriculum_manifests/{manifestId}": {
      "schema": { "$ref": "#/entities/CurriculumManifest" },
      "description": "Live published curriculum manifest and APK release info (document ID: live)"
    },
    "/curriculum_catalogs/{catalogId}": {
      "schema": { "$ref": "#/entities/CurriculumCatalog" },
      "description": "Live published modules, classes, and institutional governance settings (document ID: live)"
    },
    "/lesson_files/{chunkId}": {
      "schema": { "$ref": "#/entities/LessonFileChunk" },
      "description": "Chunked class PDF/media attachments synced from admin devices to all students"
    },
    "/users/{userId}/progress/{classId}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "User-isolated class completion and progress state synced across devices"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Admin role verification documents (read-only to owner)"
    }
  }
}
