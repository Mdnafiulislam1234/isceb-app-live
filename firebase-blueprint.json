{
  "entities": {
    "LmsUserAccount": {
      "title": "LmsUserAccount",
      "description": "Authenticated ISCEB LMS user profile with role-based access control and unique institutional Student ID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "studentId": { "type": "string", "description": "Unique ISCEB institutional ID (e.g. ISCEB-PGD-2026-AB12)" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["STUDENT", "TEACHER", "ADMIN"] },
        "organization": { "type": "string" },
        "designation": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "enrolledProgram": { "type": "string" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "PENDING_VERIFICATION", "SUSPENDED"] },
        "isVerified": { "type": "boolean" },
        "assignedModuleIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "studentId",
        "fullName",
        "email",
        "role",
        "enrolledProgram",
        "accountStatus",
        "isVerified",
        "assignedModuleIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurriculumManifest": {
      "title": "CurriculumManifest",
      "description": "Shared live ISCEB curriculum release manifest and native APK version metadata for cross-device auto-sync",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "versionCode": { "type": "integer" },
        "versionTag": { "type": "string" },
        "publishedTimestamp": { "type": "integer" },
        "publishedBy": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "announcement": { "type": "string" },
        "minSupportedAppVersion": { "type": "integer" },
        "latestApkVersionCode": { "type": "integer" },
        "latestApkVersionName": { "type": "string" },
        "apkDownloadUrl": { "type": "string" },
        "apkReleaseNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorUid",
        "versionCode",
        "versionTag",
        "publishedTimestamp",
        "publishedBy",
        "releaseNotes",
        "minSupportedAppVersion",
        "latestApkVersionCode",
        "latestApkVersionName",
        "apkDownloadUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurriculumCatalog": {
      "title": "CurriculumCatalog",
      "description": "Live ISCEB modules, lectures, media metadata, and completion settings snapshot",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "versionCode": { "type": "integer" },
        "modules": { "type": "array" },
        "classes": { "type": "array" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorUid",
        "versionCode",
        "modules",
        "classes",
        "settings",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Per-user per-class learning progress preserved across live updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "LOCKED"] },
        "startTimeMs": { "type": "integer" },
        "lastActiveTimeMs": { "type": "integer" },
        "activeLearningSeconds": { "type": "integer" },
        "idleExcludedSeconds": { "type": "integer" },
        "maxPlaybackPercent": { "type": "number" },
        "lastPlaybackPositionMs": { "type": "integer" },
        "isPdfConfirmed": { "type": "boolean" },
        "pdfReadingSeconds": { "type": "integer" },
        "lastPdfPage": { "type": "integer" },
        "totalPdfPages": { "type": "integer" },
        "visitedPdfPages": { "type": "array" },
        "quizScore": { "type": "integer" },
        "quizPassed": { "type": "boolean" },
        "completionTimestamp": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "classId",
        "status",
        "activeLearningSeconds",
        "maxPlaybackPercent",
        "isPdfConfirmed",
        "pdfReadingSeconds",
        "quizPassed",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseAssignment": {
      "title": "CourseAssignment",
      "description": "Module assignment or capstone project managed by Admin or assigned module Teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string" },
        "topicDescription": { "type": "string" },
        "instructions": { "type": "string" },
        "maxMarks": { "type": "integer" },
        "isFinalProject": { "type": "boolean" },
        "isRequired": { "type": "boolean" },
        "allowFileAttachment": { "type": "boolean" },
        "dueDateMs": { "type": "integer" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "moduleId",
        "title",
        "topicDescription",
        "instructions",
        "maxMarks",
        "isFinalProject",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AssignmentSubmission": {
      "title": "AssignmentSubmission",
      "description": "Student assignment submission and teacher/admin grade evaluation",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string" },
        "assignmentId": { "type": "string" },
        "moduleId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "submissionText": { "type": "string" },
        "attachedFileName": { "type": "string" },
        "submissionTimestamp": { "type": "integer" },
        "marksAwarded": { "type": "integer" },
        "feedback": { "type": "string" },
        "isGraded": { "type": "boolean" },
        "status": { "type": "string", "enum": ["SUBMITTED", "UNDER_REVIEW", "GRADED"] },
        "gradedByUid": { "type": "string" },
        "gradedByName": { "type": "string" },
        "gradedTimestamp": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "submissionId",
        "assignmentId",
        "moduleId",
        "studentId",
        "studentName",
        "submissionText",
        "submissionTimestamp",
        "isGraded",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseExam": {
      "title": "CourseExam",
      "description": "Timed MCQ module or comprehensive examination managed by Admin or assigned Teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string" },
        "totalMarks": { "type": "integer" },
        "isSyllabusFixedMarks": { "type": "boolean" },
        "passingPercentage": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "maxAttempts": { "type": "integer" },
        "openFromMs": { "type": "integer" },
        "openUntilMs": { "type": "integer" },
        "isRequired": { "type": "boolean" },
        "scheduledWindowNote": { "type": "string" },
        "questions": { "type": "array" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "moduleId",
        "title",
        "totalMarks",
        "passingPercentage",
        "durationMinutes",
        "questions",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Immutable record of a student examination attempt",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string" },
        "examId": { "type": "string" },
        "moduleId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentAnswers": { "type": "object" },
        "scoreMarks": { "type": "integer" },
        "totalMarks": { "type": "integer" },
        "percentage": { "type": "integer" },
        "isPassed": { "type": "boolean" },
        "startTimeMs": { "type": "integer" },
        "submittedTimeMs": { "type": "integer" },
        "isAutoSubmittedOnTimeout": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "attemptId",
        "examId",
        "moduleId",
        "studentId",
        "studentAnswers",
        "scoreMarks",
        "totalMarks",
        "percentage",
        "isPassed",
        "startTimeMs",
        "submittedTimeMs",
        "createdAt"
      ]
    },
    "IssuedCertificate": {
      "title": "IssuedCertificate",
      "description": "Official verifiable ISCEB PGD certificate record synced across public registry and user profile",
      "type": "object",
      "properties": {
        "certificateId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentCode": { "type": "string" },
        "studentName": { "type": "string" },
        "courseTitle": { "type": "string" },
        "issueDate": { "type": "string" },
        "issueTimestamp": { "type": "integer" },
        "institutionName": { "type": "string" },
        "officialWebsite": { "type": "string" },
        "authorizedSigner": { "type": "string" },
        "status": { "type": "string", "enum": ["VALID", "REVOKED"] },
        "revocationReason": { "type": "string" },
        "revocationTimestamp": { "type": "integer" },
        "completedClassesCount": { "type": "integer" },
        "totalRequiredClasses": { "type": "integer" },
        "verificationUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "certificateId",
        "studentId",
        "studentName",
        "courseTitle",
        "issueDate",
        "issueTimestamp",
        "institutionName",
        "officialWebsite",
        "authorizedSigner",
        "status",
        "completedClassesCount",
        "totalRequiredClasses",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable administrative and academic governance audit trail",
      "type": "object",
      "properties": {
        "logId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "actionType": { "type": "string" },
        "targetId": { "type": "string" },
        "summary": { "type": "string" },
        "timestampMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "logId",
        "actorUid",
        "actorName",
        "actorRole",
        "actionType",
        "targetId",
        "summary",
        "timestampMs",
        "createdAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Authoritative server-managed admin grant records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "LessonFileChunk": {
      "title": "LessonFileChunk",
      "description": "Chunked Base64 binary payload enabling cross-device Firestore distribution of admin or teacher uploaded PDFs, slides, and images",
      "type": "object",
      "properties": {
        "fileId": { "type": "string" },
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "dataBase64": { "type": "string" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "fileId",
        "chunkIndex",
        "totalChunks",
        "dataBase64",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/LmsUserAccount" },
      "description": "User accounts with strict RBAC roles, unique student IDs, and teacher module assignments"
    },
    "/users/{userId}/progress/{classId}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "User-isolated class completion and progress state synced across devices"
    },
    "/users/{userId}/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/IssuedCertificate" },
      "description": "Student-owned issued certificate references"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/CourseAssignment" },
      "description": "Course assignments managed by Admin and module-assigned Teachers"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Student assignment submissions and teacher/admin grade records"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/CourseExam" },
      "description": "Module and final exams configured by Admin and module-assigned Teachers"
    },
    "/exam_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/ExamAttempt" },
      "description": "Immutable exam attempt records per student"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/IssuedCertificate" },
      "description": "Official institutional certificate registry for public ID and QR verification"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Append-only governance and grading audit log"
    },
    "/curriculum_manifests/{manifestId}": {
      "schema": { "$ref": "#/entities/CurriculumManifest" },
      "description": "Live published curriculum manifest and APK release info (document ID: live)"
    },
    "/curriculum_catalogs/{catalogId}": {
      "schema": { "$ref": "#/entities/CurriculumCatalog" },
      "description": "Live published modules, classes, and institutional governance settings (document ID: live)"
    },
    "/lesson_files/{chunkId}": {
      "schema": { "$ref": "#/entities/LessonFileChunk" },
      "description": "Chunked class PDF/media attachments synced across devices"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Admin role verification documents (read-only to owner)"
    }
  }
}
